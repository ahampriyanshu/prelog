{
  "name": "prelog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.js",
    "build:pages": "vite build --base=/prelog/",
    "preview:pages": "vite preview --host 127.0.0.1 --base=/prelog/",
    "check:pages": "node scripts/check-pages.mjs",
    "deploy": "gh workflow run deploy.yml --repo ahampriyanshu/prelog --ref main"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
